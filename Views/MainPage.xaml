<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BreedFinder.ViewModels"
             xmlns:models="clr-namespace:BreedFinder.Models"
             xmlns:conv="clr-namespace:BreedFinder.Converters"
             x:Class="BreedFinder.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <conv:MatchColorConverter x:Key="MatchColor" />
        <conv:MatchLabelConverter x:Key="MatchLabel" />
        <conv:InvertBoolConverter x:Key="InvertBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ══ FIXED GRADIENT HEADER ══════════════════════════════════════════ -->
        <Grid Grid.Row="0" HeightRequest="118">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F4A853" Offset="0" />
                    <GradientStop Color="#E8892B" Offset="0.6" />
                    <GradientStop Color="#C4701A" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Subtle bone pattern watermark -->
            <Label Text="🐾  🐾  🐾  🐾  🐾  🐾  🐾  🐾"
                   FontSize="14" TextColor="White" Opacity="0.10"
                   HorizontalOptions="Fill" HorizontalTextAlignment="Center"
                   VerticalOptions="Start" Margin="0,8,0,0"
                   LineBreakMode="NoWrap" />

            <Grid ColumnDefinitions="*,Auto" Padding="18,50,18,14" VerticalOptions="Fill">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Spacing="3">
                    <Label Text="🐾 Breed Finder"
                           FontSize="27" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Find your perfect puppy companion"
                           FontSize="13" TextColor="#FFDFAA" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Reset"
                        Command="{Binding ResetFiltersCommand}"
                        VerticalOptions="End"
                        BackgroundColor="Transparent"
                        BorderColor="#FFFFFF60" BorderWidth="1"
                        TextColor="White" FontSize="12"
                        Padding="12,6" CornerRadius="20" />
            </Grid>
        </Grid>

        <!-- ══ SCROLLABLE BODY ════════════════════════════════════════════════ -->
        <!-- VerticalOptions="Fill" is required on Android to stretch the CollectionView -->
        <CollectionView Grid.Row="1"
                        VerticalOptions="Fill"
                        ItemsSource="{Binding MatchingBreeds}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedBreed, Mode=TwoWay}">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="0" BackgroundColor="{StaticResource PageBackground}"
                                     HorizontalOptions="Fill">

                    <!-- ── Filter toggle bar ─────────────────────────────── -->
                    <Grid BackgroundColor="{StaticResource Surface}"
                          Padding="16,12" ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource TagBackground}"
                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                Padding="8,4">
                            <Label Text="🐶 Filters" FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="Adjust sliders to match your lifestyle"
                               FontSize="12" TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" Margin="8,0,0,0" />
                        <!-- Two buttons toggled by visibility — avoids bool→string converter -->
                        <Button Grid.Column="2" Text="▲"
                                IsVisible="{Binding FiltersExpanded}"
                                Command="{Binding ToggleFiltersCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="18" Padding="4,0" />
                        <Button Grid.Column="2" Text="▼"
                                IsVisible="{Binding FiltersExpanded, Converter={StaticResource InvertBool}}"
                                Command="{Binding ToggleFiltersCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource TextSecondary}"
                                FontSize="18" Padding="4,0" />
                    </Grid>

                    <!-- ── Collapsible filter panel ──────────────────────── -->
                    <!-- HorizontalOptions="Fill" required on Android so VerticalStackLayout stretches full width -->
                    <VerticalStackLayout IsVisible="{Binding FiltersExpanded}"
                                         HorizontalOptions="Fill"
                                         Spacing="10" Padding="12,10,12,0"
                                         BackgroundColor="{StaticResource PageBackground}">

                        <!-- SIZE & BUILD -->
                        <Border HorizontalOptions="Fill"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource Surface}"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="#E8892B" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <VerticalStackLayout HorizontalOptions="Fill" Spacing="16">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="📐" FontSize="16" VerticalOptions="Center" />
                                    <Label Text="Size &amp; Build" FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Size" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding SizeLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding SizeValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="🫶 Teacup" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Gentle Giant 🐻" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- TEMPERAMENT -->
                        <Border HorizontalOptions="Fill"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource Surface}"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="#E8892B" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <VerticalStackLayout HorizontalOptions="Fill" Spacing="16">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🎾" FontSize="16" VerticalOptions="Center" />
                                    <Label Text="Temperament" FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Energy Level" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding EnergyLevelLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding EnergyLevelValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="💤 Couch Potato" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Zoomies 24/7 🏃" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Aggressiveness" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding AggressivenessLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding AggressivenessValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="😇 Very Gentle" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Very Dominant 😤" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Guardedness" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding GuardednessLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding GuardednessValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="🤝 Greets Everyone" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Guard Dog 🛡️" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Loyalty" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding LoyaltyLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding LoyaltyValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="🦅 Free Spirit" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Shadow Dog 💛" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Single Owner" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding SingleOwnerLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding SingleOwnerValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="👨‍👩‍👧 Loves Everyone" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="One-Person Dog 🤝" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- CARE & GROOMING -->
                        <Border HorizontalOptions="Fill"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource Surface}"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="#E8892B" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <VerticalStackLayout HorizontalOptions="Fill" Spacing="16">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🛁" FontSize="16" VerticalOptions="Center" />
                                    <Label Text="Care &amp; Grooming" FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Shedding" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding SheddingLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding SheddingValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="✨ Barely Any" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Fur Everywhere 🌪️" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Grooming Needs" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding GroomingNeedsLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding GroomingNeedsValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="✂️ Quick Brush" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Salon Regular 💅" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Vet Visits Required" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding VetVisitsLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding VetVisitsValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="🏅 Rarely Needed" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Frequent Checkups 🩺" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- HEALTH & VITALITY -->
                        <Border HorizontalOptions="Fill"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource Surface}"
                                Padding="16,14">
                            <Border.Shadow>
                                <Shadow Brush="#E8892B" Offset="0,2" Radius="8" Opacity="0.06" />
                            </Border.Shadow>
                            <VerticalStackLayout HorizontalOptions="Fill" Spacing="16">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="🦴" FontSize="16" VerticalOptions="Center" />
                                    <Label Text="Health &amp; Vitality" FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Immunity" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding ImmunityLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding ImmunityValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="🤧 Delicate" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Unbreakable 💪" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout HorizontalOptions="Fill" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Lifespan" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" BackgroundColor="{StaticResource TagBackground}"
                                                StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="8,3">
                                            <Label Text="{Binding LifespanLabel}" FontSize="12"
                                                   TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="10" Value="{Binding LifespanValue}"
                                            MinimumTrackColor="{StaticResource Primary}"
                                            MaximumTrackColor="{StaticResource SliderTrack}"
                                            ThumbColor="{StaticResource Primary}" />
                                    <Grid ColumnDefinitions="*,*">
                                        <Label Text="⏳ Short Life" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                        <Label Grid.Column="1" Text="Forever Friend ♾️" FontSize="11"
                                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- ── FIND MY BREED BUTTON ──────────────────────────── -->
                    <!--
                        Cross-platform touch strategy:
                        • Android: CollectionView's scroll gesture swallows TapGestureRecognizer,
                          so a real Button element is required.
                        • iOS: a Border rendered on top of a transparent Button absorbs touches
                          before they reach the Button (even when the Button has higher z-order
                          in some CollectionView header rendering paths).
                        Fix: declare the Button FIRST (bottom z-order), then the visual Border
                        SECOND (top z-order, InputTransparent="True").  iOS hit-tests front-to-back,
                        finds the Border is input-transparent, skips it, and routes the touch to the
                        Button behind it.  Android behaves the same way.  Visuals are unaffected.
                    -->
                    <Grid Margin="12,14,12,4" HeightRequest="60">

                        <!-- ① Touch target — sits at bottom of z-stack but receives all touches
                             because the visual layer above it is InputTransparent. -->
                        <Button Command="{Binding FindBreedsAsyncCommand}"
                                IsEnabled="{Binding IsNotLoading}"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                CornerRadius="20"
                                HeightRequest="60" />

                        <!-- ② Visual-only gradient layer — InputTransparent="True" lets every
                             touch fall through to the Button declared above. -->
                        <Border InputTransparent="True"
                                StrokeShape="RoundRectangle 20" Stroke="Transparent">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F4A853" Offset="0" />
                                    <GradientStop Color="#E8892B" Offset="0.6" />
                                    <GradientStop Color="#C4701A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#E8892B" Offset="0,4" Radius="14" Opacity="0.35" />
                            </Border.Shadow>
                            <!-- Loading state -->
                            <HorizontalStackLayout IsVisible="{Binding IsLoading}"
                                                    HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                                <ActivityIndicator IsRunning="True" Color="White"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Sniffing out your perfect breed…"
                                       TextColor="White" FontSize="15" FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <!-- Normal state -->
                            <Label IsVisible="{Binding IsLoading, Converter={StaticResource InvertBool}}"
                                   Text="🔍  Find My Breed  🐾"
                                   TextColor="White" FontSize="17" FontAttributes="Bold"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                    </Grid>

                    <!-- ── Results count header ──────────────────────────── -->
                    <Grid IsVisible="{Binding IsResultsVisible}"
                          Padding="16,12,16,8" ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ResultsHeader}"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource TagBackground}"
                                StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                Padding="10,4">
                            <Label Text="🐾 Tap a card for details"
                                   FontSize="11" TextColor="{StaticResource Primary}" />
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ══ 2-COLUMN BREED GRID ════════════════════════════════════════ -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2"
                                 HorizontalItemSpacing="8" VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DogBreed">
                    <Grid Padding="6,0">
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{StaticResource BorderColor}" StrokeThickness="0.5"
                                BackgroundColor="{StaticResource Surface}">
                            <Border.Shadow>
                                <Shadow Brush="#E8892B" Offset="0,3" Radius="12" Opacity="0.10" />
                            </Border.Shadow>

                            <Grid RowDefinitions="155,Auto" RowSpacing="0">

                                <!-- ── Image / Placeholder area ───────────── -->
                                <Grid Grid.Row="0">
                                    <Grid BackgroundColor="{Binding AccentColor}">
                                        <Label Text="{Binding Emoji}" FontSize="52"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                    <Image Source="{Binding ImageUrl}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasImage}" />
                                    <Grid VerticalOptions="End" HeightRequest="50">
                                        <Grid.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0" />
                                                <GradientStop Color="#99000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Grid.Background>
                                    </Grid>
                                    <Border HorizontalOptions="Start" VerticalOptions="End"
                                            Margin="8" Padding="7,3"
                                            BackgroundColor="{Binding MatchScore, Converter={StaticResource MatchColor}}"
                                            StrokeShape="RoundRectangle 8" Stroke="Transparent">
                                        <Label Text="{Binding MatchPercentText}"
                                               TextColor="White" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                    <Border HorizontalOptions="End" VerticalOptions="End"
                                            Margin="8" Padding="7,3"
                                            BackgroundColor="#CC000000"
                                            StrokeShape="RoundRectangle 8" Stroke="Transparent">
                                        <Label Text="{Binding MatchScore, Converter={StaticResource MatchLabel}}"
                                               TextColor="White" FontSize="10" />
                                    </Border>
                                </Grid>

                                <!-- ── Details area ───────────────────────── -->
                                <VerticalStackLayout Grid.Row="1" HorizontalOptions="Fill"
                                                     Padding="10,10,10,12" Spacing="5">
                                    <Label Text="{Binding Name}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Group}"
                                           FontSize="11" TextColor="{StaticResource TextSecondary}" />
                                    <ProgressBar Progress="{Binding MatchScore}"
                                                 ProgressColor="{Binding MatchScore, Converter={StaticResource MatchColor}}"
                                                 BackgroundColor="{StaticResource SliderTrack}"
                                                 HeightRequest="4" />
                                    <Label Text="{Binding TagsDisplay}"
                                           FontSize="10" TextColor="{StaticResource Primary}"
                                           MaxLines="1" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty / pre-search state -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                     Spacing="16" Padding="40,40">
                    <Label Text="🐕" FontSize="72" HorizontalOptions="Center" />
                    <Label Text="Your perfect pup is out there!"
                           FontSize="19" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Dial in your preferences above, then tap  🔍 Find My Breed  to discover dogs that match your lifestyle."
                           FontSize="14" TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           LineHeight="1.5" />
                    <!-- Decorative paw row -->
                    <Label Text="🐾  🐾  🐾"
                           FontSize="22" HorizontalOptions="Center"
                           Opacity="0.35" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="32" Color="Transparent" />
            </CollectionView.Footer>

        </CollectionView>
    </Grid>

