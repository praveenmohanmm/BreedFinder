<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BreedFinder.ViewModels"
             xmlns:conv="clr-namespace:BreedFinder.Converters"
             x:Class="BreedFinder.Views.BreedDetailPage"
             x:DataType="vm:BreedDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <conv:MatchColorConverter x:Key="MatchColor" />
        <conv:MatchLabelConverter x:Key="MatchLabel" />
        <conv:TraitProgressConverter x:Key="TraitProgress" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- ══ HERO IMAGE HEADER ══════════════════════════════════════════ -->
            <Grid HeightRequest="280">

                <!-- Coloured placeholder (always visible, covered by real photo) -->
                <Grid BackgroundColor="{Binding Breed.AccentColor}">
                    <Label Text="{Binding Breed.Emoji}" FontSize="72"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <!-- Real dog photo -->
                <Image Source="{Binding Breed.ImageUrl}"
                       Aspect="AspectFill"
                       IsVisible="{Binding Breed.HasImage}" />

                <!-- Gradient scrim — top (for back button legibility) -->
                <Grid VerticalOptions="Start" HeightRequest="100">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99000000" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                </Grid>

                <!-- Gradient scrim — bottom (warm amber tint for name text legibility) -->
                <Grid VerticalOptions="End" HeightRequest="130">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="#CC3D1F08" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                </Grid>

                <!-- Back button -->
                <Button Text="← Back"
                        Command="{Binding GoBackCommand}"
                        HorizontalOptions="Start" VerticalOptions="Start"
                        Margin="12,50,0,0"
                        BackgroundColor="Transparent"
                        TextColor="White" FontAttributes="Bold" FontSize="15"
                        Padding="0" />

                <!-- Breed name over gradient -->
                <VerticalStackLayout VerticalOptions="End" Padding="18,0,18,18" Spacing="4">
                    <Label Text="{Binding Breed.Name}"
                           FontSize="26" FontAttributes="Bold" TextColor="White"
                           LineBreakMode="TailTruncation" />
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding Breed.Group}"
                               FontSize="14" TextColor="#CCFFFFFF" />
                        <Label Text="·" FontSize="14" TextColor="#66FFFFFF" />
                        <Label Text="{Binding Breed.Origin}"
                               FontSize="14" TextColor="#CCFFFFFF" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </Grid>

            <!-- ══ MATCH / STATS CARD ════════════════════════════════════════ -->
            <Border Margin="16,-28,16,0"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18" Padding="0,14">
                <Border.Shadow>
                    <Shadow Brush="#E8892B" Offset="0,4" Radius="14" Opacity="0.14" />
                </Border.Shadow>
                <Grid ColumnDefinitions="*,1,*,1,*">
                    <!-- Match % -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="3">
                        <Label Text="{Binding Breed.MatchPercentText}"
                               FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{Binding Breed.MatchScore, Converter={StaticResource MatchColor}}" />
                        <Border BackgroundColor="{Binding Breed.MatchScore, Converter={StaticResource MatchColor}}"
                                StrokeShape="RoundRectangle 6" Stroke="Transparent"
                                Padding="8,2" HorizontalOptions="Center">
                            <Label Text="{Binding Breed.MatchScore, Converter={StaticResource MatchLabel}}"
                                   FontSize="11" TextColor="White" FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>
                    <!-- Divider -->
                    <BoxView Grid.Column="1" Color="{StaticResource BorderColor}" WidthRequest="1" />
                    <!-- Origin -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="3">
                        <Label Text="{Binding Breed.Origin}"
                               FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{StaticResource TextPrimary}"
                               MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Text="Origin" FontSize="11" HorizontalOptions="Center"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <!-- Divider -->
                    <BoxView Grid.Column="3" Color="{StaticResource BorderColor}" WidthRequest="1" />
                    <!-- Group -->
                    <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="3">
                        <Label Text="{Binding Breed.Group}"
                               FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"
                               TextColor="{StaticResource TextPrimary}"
                               MaxLines="1" LineBreakMode="TailTruncation" />
                        <Label Text="Group" FontSize="11" HorizontalOptions="Center"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ══ ABOUT ══════════════════════════════════════════════════════ -->
            <Border Margin="16,12,16,0"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18" Padding="16,14">
                <Border.Shadow>
                    <Shadow Brush="#E8892B" Offset="0,2" Radius="8" Opacity="0.06" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🐾" FontSize="15" VerticalOptions="Center" />
                        <Label Text="About" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Breed.Description}"
                           FontSize="14" LineHeight="1.6"
                           TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>
            </Border>

            <!-- ══ TRAIT PROFILE ═════════════════════════════════════════════ -->
            <Border Margin="16,12,16,0"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18" Padding="16,14">
                <Border.Shadow>
                    <Shadow Brush="#E8892B" Offset="0,2" Radius="8" Opacity="0.06" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🏅" FontSize="15" VerticalOptions="Center" />
                        <Label Text="Trait Profile" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout Spacing="11">

                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Size" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.Size, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.Size, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Energy Level" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.EnergyLevel, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.EnergyLevel, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Shedding" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.Shedding, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.Shedding, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Guardedness" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.Guardedness, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.Guardedness, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Aggressiveness" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.Aggressiveness, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.Aggressiveness, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Immunity" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.Immunity, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="#22C55E" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.Immunity, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="#22C55E" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Lifespan" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.Lifespan, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="#22C55E" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.Lifespan, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="#22C55E" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Grooming Needs" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.GroomingNeeds, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.GroomingNeeds, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Vet Visits" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.VetVisitsRequired, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="#F59E0B" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.VetVisitsRequired, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="#F59E0B" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Loyalty" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.Loyalty, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.Loyalty, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="130,*,30">
                            <Label Text="Single Owner" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <ProgressBar Grid.Column="1" Progress="{Binding Breed.SingleOwner, Converter={StaticResource TraitProgress}}"
                                         ProgressColor="{StaticResource Primary}" BackgroundColor="{StaticResource SliderTrack}"
                                         HeightRequest="8" VerticalOptions="Center" Margin="0,0,8,0" />
                            <Label Grid.Column="2" Text="{Binding Breed.SingleOwner, StringFormat='{0:0}'}"
                                   FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ══ TAGS ══════════════════════════════════════════════════════ -->
            <Border Margin="16,12,16,36"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 18" Padding="16,14">
                <Border.Shadow>
                    <Shadow Brush="#E8892B" Offset="0,2" Radius="8" Opacity="0.06" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⭐" FontSize="15" VerticalOptions="Center" />
                        <Label Text="Highlights" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <FlexLayout Wrap="Wrap" Direction="Row">
                        <BindableLayout.ItemsSource>
                            <Binding Path="Breed.Tags" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BackgroundColor="{StaticResource TagBackground}"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource Primary}" StrokeThickness="0.5"
                                        Padding="12,7" Margin="0,0,6,6">
                                    <Label Text="{Binding .}" FontSize="13"
                                           TextColor="{StaticResource Primary}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
